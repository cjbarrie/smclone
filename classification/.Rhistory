library(dplyr)
library(readr)
# Read the CSV file
tweets <- read_csv("data/tweets_sample_filtered_classified.csv")
# Check the first few rows of the dataframe to ensure it was read correctly
print(head(tweets))
# Filter the tweets
tweetslr <- tweets %>%
filter(code_gpt != "Neither left nor right")
# Check the first few rows of the filtered dataframe
print(head(tweetslr))
# Filter the tweets
tweetslr <- tweets %>%
filter(code_gpt != "Neither left nor right" & !is.na(code_gpt))
View(tweets)
# Filter the tweets
tweetslr <- tweets %>%
filter(code_gpt != "Neither left nor right" | !is.na(code_gpt))
# Filter the tweets
tweetslr <- tweets %>%
filter(code_gpt != "Neither left nor right" & !is.na(code_gpt))
View(tweetslr)
# Filter the tweets
tweetslr <- tweets %>%
filter(code_gpt == "Very left" | code_gpt == "Very right")
View(tweetslr)
tweetslr <- tweets %>%
# filter(code_gpt == "Very left" | code_gpt == "Very right")
filter(code_gpt != "Neither left nor right" & !is.na(code_gpt))
