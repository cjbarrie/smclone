df_cb <- read.csv("data/us/usa_timeline_manual_cb.csv", stringsAsFactors = FALSE)
# 2. Filter each dataframe to keep only rows coded 1.
# (Here we assume each CSV has a column named 'code' that equals 1 when the row was selected.)
df_aa <- df_aa %>% filter(use == 1)
df_ak <- df_ak %>% filter(use == 1)
df_cb <- df_cb %>% filter(use == 1)
# 3. Merge the dataframes by a common identifier.
# This assumes that each CSV contains a common 'id' column. The merge will keep only rows
# that appear (with code == 1) in all three dataframes.
# (If your CSVs have different key names, update "id" accordingly.)
df_merged <- list(df_aa, df_ak, df_cb) %>%
reduce(function(x, y) merge(x, y, by = "id"))
View(df_merged)
View(df_merged)
View(df_merged)
# Load necessary libraries
library(dplyr)
library(purrr)
# 1. Read in the three CSV files.
df_aa <- read.csv("data/us/usa_timeline_manual_aa.csv", stringsAsFactors = FALSE)
df_ak <- read.csv("data/us/usa_timeline_manual_ak.csv.csv", stringsAsFactors = FALSE)
df_cb <- read.csv("data/us/usa_timeline_manual_cb.csv", stringsAsFactors = FALSE)
df_aa <- df_aa %>% filter(use == 1) %>%
select(id, text, code_gpt)
df_ak <- df_ak %>% filter(use == 1) %>%
select(id)
df_cb <- df_cb %>% filter(use == 1) %>%
select(id)
df_merged <- list(df_aa, df_ak, df_cb) %>%
reduce(function(x, y) merge(x, y, by = "id"))
View(df_merged)
# For balancing the data: find the minimum count across each level of 'code_gpt'
group_counts <- df_merged %>%
group_by(code_gpt) %>%
summarise(n = n())
View(group_counts)
min_n <- min(group_counts$n)
# 5. Sample exactly 'min_n' rows from each group so that each code_gpt label has the same number of rows.
df_balanced <- df_merged %>%
group_by(code_gpt) %>%
sample_n(min_n) %>%
ungroup()
# 5. Sample exactly 'min_n' rows from each group so that each code_gpt label has the same number of rows.
df_balanced <- df_merged %>%
group_by(code_gpt) %>%
sample_n(min_n) %>%
ungroup()
View(df_balanced)
group_counts <- df_merged %>%
group_by(code_gpt) %>%
summarise(n = n())
min_n <- min(group_counts$n) -2 #get 15 of each
# 5. Sample exactly 'min_n' rows from each group so that each code_gpt label has the same number of rows.
df_balanced <- df_merged %>%
group_by(code_gpt) %>%
sample_n(min_n) %>%
ungroup()
View(df_balanced)
# Write the balanced dataset to CSV
write_csv(df_balanced, "data/us/final/usa_timeline_final.csv")
