# Read the CSV file
dat <- read_csv("data/tweets_pre-elec_classified.csv") %>%
filter(use == 1)
# Sample tweets
sampled_tweets <- dat %>%
group_by(classification) %>%
filter(classification %in% c("Very right", "Somewhat right", "Very left", "Somewhat left")) %>%
mutate(sample_size = case_when(
classification %in% c("Very right", "Very left") ~ 15,
classification %in% c("Somewhat right", "Somewhat left") ~ 35
)) %>%
slice_sample(n = unique(sample_size))
# Sample tweets
sampled_tweets <- dat %>%
group_by(classification) %>%
filter(classification %in% c("Very right", "Somewhat right", "Very left", "Somewhat left")) %>%
mutate(sample_size = case_when(
classification %in% c("Very right", "Very left") ~ 15,
classification %in% c("Somewhat right", "Somewhat left") ~ 35
)) %>%
slice_sample(n = unique(sample_size))
# Sample tweets from each classification
sampled_tweets <- bind_rows(
dat %>% filter(classification == "Very right") %>% slice_sample(n = 15),
dat %>% filter(classification == "Somewhat right") %>% slice_sample(n = 35),
dat %>% filter(classification == "Very left") %>% slice_sample(n = 15),
dat %>% filter(classification == "Somewhat left") %>% slice_sample(n = 35)
)
