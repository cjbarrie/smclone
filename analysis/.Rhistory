library(dplyr)
library(readr)
qualtricsdat <- read_csv("data/test/qualtrics.csv")
posthogdat <- read_csv("data/test/posthog.csv")
View(qualtricsdat)
View(qualtricsdat)
qualtricsdat <- qualtricsdat[-1:2,]
qualtricsdat <- qualtricsdat[-1:2,]
qualtricsdat <- qualtricsdat[-c(1:2),]
View(qualtricsdat)
View(qualtricsdat)
View(posthogdat)
tweetsdat <- read_csv("data/test/tweets.csv")
View(tweetsdat)
View(posthogdat)
View(posthogdat)
View(posthogdat)
colnames(posthogdat)
View(posthogdat)
qualtricsdat <- read_csv("data/test/qualtrics.csv")
qualtricsdat <- qualtricsdat[-c(1:2),]
View(qualtricsdat)
posthogdat <- read_csv("data/test/posthog.csv")
View(posthogdat)
colnames(posthogdat)
# Extract relevant information from posthogdat
# Ensure that the column names are properly formatted (e.g., replace * with something valid)
posthogdat_filtered <- posthogdat %>%
select(session_id = `*.properties.$session_id`,
prolific_id = `*.properties.PROLIFIC_PID`,  # Or use the correct column for prolific ID
tweet_id = `*.properties.properties.tweet_id`)
View(posthogdat_filtered)
# Fill in where cell doesn't contain prolific ID
posthogdat_filtered <- posthogdat_filtered %>%
group_by(session_id) %>%
mutate(prolific_id = ifelse(is.na(prolific_id), first(na.omit(prolific_id)), prolific_id)) %>%
ungroup()
View(posthogdat_filtered)
