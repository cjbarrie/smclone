# Load necessary libraries
library(dplyr)
library(readr)
# Step 1: Read in the data
posthogdat <- read_csv("data/US/test/export.csv")
# Step 2: Filter and retain only the relevant columns and rows for August 28, 2024
posthogdat_filtered <- posthogdat %>%
mutate(date_only = as.Date(`*.properties.$sent_at`)) %>%  # Extract date from timestamp
filter(date_only >= "2025-04-18") %>%                     # Filter for specific date
select(
session_id = `*.properties.$session_id`,
# Select necessary columns
respondent_id = `*.properties.distinct_id`,
tweet_id = `*.properties.properties.tweet_id`,
event_type = `*.event`
)
# Step 3: Fill missing prolific IDs based on session_id
posthogdat_filtered <- posthogdat_filtered %>%
group_by(session_id) %>%
mutate(respondent_id = ifelse(is.na(respondent_id), first(na.omit(respondent_id)), respondent_id)) %>%
ungroup()
# Step 4: Save the cleaned dataset
write_csv(posthogdat_filtered, "data/US/test/posthog.csv")
# # Remove the original data file as too large
# file.remove("data/main/export.csv")
library(dplyr)
library(readr)
library(ggplot2)
library(broom)
options(scipen = 999)
# --------------------------
# Read in data
# --------------------------
qualtricsdat <- read_csv("data/US/test/qualtrics.csv")
qualtricsdat <- qualtricsdat[-c(1:2), ]
posthogdat_filtered <- read_csv("data/US/test/posthog.csv")
# Read tweets and generate placeholder like/retweet counts
tweetsdat <- read_csv("data/US/test/tweets.csv") %>%
select(id, classification, rt_rand, like_rand) %>%
rename(
retweets_count = rt_rand,
likes_count    = like_rand
) %>%
mutate(endorsement = retweets_count + likes_count)
# --------------------------
data_merged <- posthogdat_filtered %>%
left_join(tweetsdat, by = c("tweet_id" = "id")) %>%
# filter(!is.na(classification)) %>%
left_join(qualtricsdat, by = c("respondent_id" = "Q16")) %>%
filter(!is.na(respondent_id))
# Plot distribution of ideology scores
data_merged$ideo_numeric <- as.numeric(data_merged$Q2_1)
attention_merged <- data_merged %>%
select(respondent_id, Q13_1, Q13_2, Q13_3) %>%
mutate(attention_combination = paste(Q13_1, Q13_2, Q13_3, sep = " ")) %>%
distinct(.keep_all = TRUE)
attention_tabulation <- attention_merged %>%
count(attention_combination) %>%
arrange(desc(n))
# --------------------------
# Recode and standardize variables
# --------------------------
variables_to_standardize <- c("ideo_numeric",
"polint",
"age",
"education",
"smuse",
"endorsement")
data_standardized <- data_merged %>%
mutate(
binary_tweet = ifelse(classification %in% c("Very left", "Somewhat left"), 0, 1),
polint = case_when(
Q14_1 == "0 (Not at all interested)" ~ 0,
Q14_1 == "1" ~ 1,
Q14_1 == "2" ~ 2,
Q14_1 == "3" ~ 3,
Q14_1 == "4" ~ 4,
Q14_1 == "5 (Very interested)" ~ 5,
TRUE ~ NA_real_
),
gender = ifelse(Q9 == "Prefer not to say", NA, as.numeric(factor(Q9))),
age = as.numeric(Q8),
education = case_when(
Q10 == "20+" ~ 20,
Q10 == "15 or under" ~ 15,
Q10 == "19" ~ 19,
Q10 == "17-18" ~ 18,
Q10 == "16" ~ 16,
Q10 == "Can't remember" ~ NA_real_,
Q10 == "Still at school/Full time student" ~ as.numeric(age),
TRUE ~ NA_real_
),
smuse = sapply(strsplit(Q7, ","), length),
endorsement = endorsement
)
# Standardize the data (convert each variable to a scaled numeric vector)
data_standardized <- data_standardized %>% mutate(across(all_of(variables_to_standardize), scale))
# --------------------------
# Full-sample analysis: Run logistic regressions for each event type
# --------------------------
# For "like_click"
data_like_click <- data_standardized %>% filter(event_type == "like_click")
model_like_click <- glm(
binary_tweet ~ ideo_numeric + polint + gender + age + income + smuse + education + endorsement,
data = data_like_click,
family = binomial
)
