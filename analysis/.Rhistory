logistic_model <- glm(binary_tweet ~ ideo_numeric + polint + gender + age + income + smuse + education,
data = filtered_data,
family = binomial)
# Extract coefficient for ideo_numeric
coef_data <- tidy(logistic_model) %>%
filter(term == "ideo_numeric") %>%
mutate(event_type = event_type_filter)
return(coef_data)
}
